# Fill on the backend computer ONLY, then rename to .env (not in Git).
DEVICE_ID=stirrer-001
MQTT_HOST=f8f1e9df.ala.cn-shenzhen.emqxsl.cn
MQTT_PORT=8883
MQTT_USER=smartstir-backend
MQTT_PASSWORD=SET_LOCALLY
# Optional when EMQX TLS certificate is trusted by system CA store:
# MQTT_CA_PATH=../certs/emqxsl-ca.crt  # Local run only. Railway Docker uses system CA trust.
APP_USERNAME=admin
# Generate the pair below with: python ../tools/make_password.py
APP_PASSWORD_SALT=REPLACE_ME
APP_PASSWORD_HASH=REPLACE_ME
DB_PATH=./local.db
